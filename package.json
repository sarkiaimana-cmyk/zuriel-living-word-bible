{
  "name": "zuriel-living-word-bible",
  "version": "1.0.1",
  "private": true,
  "description": "Standalone Android app and offline-first Bible reader.",
  "scripts": {
    "build:web": "node scripts/prepare-web.mjs",
    "android:sync": "npm run build:web && cap sync android",
    "android:build": "npm run build:web && cap sync android",
    "study:faith-coverage": "node scripts/check-faith-response-coverage.mjs",
    "test:mobile": "node scripts/test-reader-mobile.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capgo/capacitor-file-sharer": "8.1.18"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.12",
    "playwright": "1.65.1"
  }
}
